# Connexion Google (bouton « Continuer avec Google »)
VITE_GOOGLE_CLIENT_ID=

# --- Suivi GPS des trajets ---------------------------------------------------
# Clé NAVIGATEUR Google Maps Platform (Maps JavaScript API), restreinte aux
# domaines SaaCare dans la console Google Cloud. Sans elle, le suivi reste
# fonctionnel : la carte laisse place à la distance et à l'arrivée estimée.
VITE_GOOGLE_MAPS_API_KEY=

# Transport temps réel : « polling » (défaut, compatible hébergement mutualisé)
# ou « socket » (service WebSocket externe ou Reverb sur VPS).
VITE_REALTIME_DRIVER=polling

# Rythme du transport de secours, en millisecondes.
# VITE_TRACKING_POLL_INTERVAL=5000
# VITE_TRACKING_POLL_HIDDEN=20000

# Renseigner uniquement avec VITE_REALTIME_DRIVER=socket
# (npm i laravel-echo pusher-js)
# VITE_PUSHER_APP_KEY=
# VITE_PUSHER_APP_CLUSTER=mt1
# VITE_PUSHER_HOST=
# VITE_PUSHER_PORT=443
# VITE_PUSHER_SCHEME=https
