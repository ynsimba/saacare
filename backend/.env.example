APP_NAME=SaaCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.saacare.com
FRONTEND_URL=https://www.saacare.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=saacare_web
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Diffusion temps réel du suivi GPS.
#   log     → aucun WebSocket (hébergement mutualisé Hostinger) : le front bascule
#             automatiquement sur son transport de secours. C'est la valeur par défaut.
#   pusher  → service WebSocket externe (Pusher, Ably, Reverb sur VPS) :
#             composer require pusher/pusher-php-server, puis renseigner PUSHER_*.
BROADCAST_CONNECTION=log

# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hello@saacare.com
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=hello@saacare.com
MAIL_FROM_NAME=SaaCare
CONTACT_RECIPIENTS=hello@saacare.com,sephorasoki@saacare.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SANCTUM_STATEFUL_DOMAINS=www.saacare.com,saacare.com,localhost:5173

# --- Suivi GPS des trajets (§4.4) -------------------------------------------
# Clé SERVEUR Google Maps Platform, restreinte à l'API Routes et à l'IP du serveur.
# Sans elle, la distance et l'heure d'arrivée sont estimées localement.
GOOGLE_MAPS_SERVER_KEY=

# Réglages du suivi (valeurs par défaut dans config/tracking.php)
# TRACKING_MIN_INTERVAL=8
# TRACKING_MIN_DISTANCE=25
# TRACKING_MAX_ACCURACY=250
# TRACKING_STALE_AFTER=60
# TRACKING_MAX_POINTS=120
# TRACKING_RETAIN_POINTS_DAYS=2
# TRACKING_ROUTE_REFRESH=45
