<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Canonical host : www.saacare.com
    RewriteCond %{HTTP_HOST} ^saacare\.com$ [NC]
    RewriteRule ^ https://www.saacare.com%{REQUEST_URI} [L,R=301]

    # Ne pas toucher aux sous-dossiers API / ancien app
    RewriteRule ^(api|app)(/|$) - [L]

    # Assets / fichiers réels
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA React Router
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(index\.html|site\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
