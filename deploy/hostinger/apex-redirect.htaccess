# Obsolète si la PWA est à la racine de public_html.
# Conservé pour un hébergement où saacare.com n’a que la redirection.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^(.*)$ https://www.saacare.com/$1 [L,R=301]
</IfModule>
